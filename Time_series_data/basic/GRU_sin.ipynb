   "source": [
    "def generate_data(seq_length):\n",
    "    x = np.linspace(0, 2 *np.pi , seq_length)\n",
    "    y = np.sin(x)\n",
    "    return y\n",
    "\n",
    "seq_length = 50\n",
    "data = generate_data(seq_length)\n",
    "plt.plot(data)\n",
    "plt.show()"
   ]
  }
